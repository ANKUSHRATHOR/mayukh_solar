# Copy to .env and fill in. Never commit the real .env — it holds the service-role key.

PORT=8787

# Same Supabase project the frontend points at.
SUPABASE_URL=https://fjpjgsfcnicslwhrjqgl.supabase.co
SUPABASE_ANON_KEY=
# Dashboard → Project Settings → API → service_role. Full DB access, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Web push (same values the send-push edge function used).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mayukhsolar.com

# Shared secret that lets DB triggers / cron post to /api/send-push without a user JWT.
INTERNAL_PUSH_SECRET=
