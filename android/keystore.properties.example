# Copy to android/keystore.properties and fill in your own values.
#
# That file is gitignored and holds passwords in plain text. This repo is
# public — never commit the real one, and never paste these values into chat,
# an issue, or a commit message.
#
# Generate the keystore first (see README, "Building a signed release APK").
# Back up the .jks file somewhere off this machine: it cannot be regenerated,
# and without it you can never ship an update to an already-installed app.

storeFile=/absolute/path/to/mayukh-solar-release.jks
storePassword=
keyAlias=mayukh-solar
keyPassword=
